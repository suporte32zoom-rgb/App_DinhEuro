# ==============================================================================
# DinhEuro (dinheuro.com / dinheuro.com.br) - Configuração de Produção Apache/LiteSpeed
# Destinado à pasta /dist (ou document root de produção)
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Forçar conexão segura HTTPS (se não estiver em localhost)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^localhost
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Tipos MIME Corretos para PWA, Módulos ES e Fontes
  <IfModule mod_mime.c>
    AddType application/javascript .js .mjs
    AddType text/css .css
    AddType application/manifest+json .webmanifest .json
    AddType image/svg+xml .svg
    AddType image/png .png
    AddType image/webp .webp
    AddType font/woff2 .woff2
    AddType font/woff .woff
  </IfModule>

  # 3. Servir arquivos e diretórios existentes diretamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Fallback SPA: Redirecionar todas as rotas de navegação para index.html
  # Permite que URLs diretas como /mercados, /termos-de-uso, /sobre funcionem perfeitamente
  RewriteRule ^ index.html [L]
</IfModule>

# Compressão Gzip / Deflate para carregamento ultrarrápido em produção
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Cache inteligente de assets estáticos e sem cache para HTML da aplicação
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 1 hour"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# Proteção de cabeçalhos de segurança
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
